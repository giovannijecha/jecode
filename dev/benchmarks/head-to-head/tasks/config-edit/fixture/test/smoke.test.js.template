import { test } from 'node:test';
import assert from 'node:assert/strict';
import { parsePointer, patchDocument } from '../src/index.js';
test('root and escaped pointers', () => {
  assert.deepEqual(parsePointer(''), []);
  assert.deepEqual(parsePointer('/a~1b/~0'), ['a/b', '~']);
});
test('set preserves the document', () => {
  const before = { enabled: false };
  assert.deepEqual(patchDocument(before, [{ op: 'set', path: '/enabled', value: true }]), { enabled: true });
  assert.deepEqual(before, { enabled: false });
});
