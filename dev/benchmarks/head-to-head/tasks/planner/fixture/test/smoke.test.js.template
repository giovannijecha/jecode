import test from 'node:test';
import assert from 'node:assert/strict';
import { planBuild } from '../src/index.js';
import { formatPlan } from '../src/format.js';

test('a single task retains its duration', () => {
  assert.deepEqual(planBuild({ tasks: [{ id:'build', deps:[], duration:5 }] }), {
    order:['build'], waves:[['build']], totalDuration:5, criticalPathDuration:5,
  });
});
test('format emits JSON plus newline', () => {
  assert.equal(formatPlan({ order:[] }), '{"order":[]}\n');
});
