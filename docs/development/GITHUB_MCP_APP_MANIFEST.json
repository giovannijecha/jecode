{
  "name": "Jecode GitHub MCP",
  "url": "https://github.com/giovannijecha/jecode",
  "description": "Connect Jecode to GitHub's remote MCP server with user-authorized access.",
  "public": true,
  "default_events": [],
  "default_permissions": {
    "actions": "write",
    "checks": "read",
    "contents": "write",
    "issues": "write",
    "pull_requests": "write",
    "statuses": "read",
    "workflows": "write"
  },
  "request_oauth_on_install": false
}
